[Unit]
Description=Video to Notes private beta
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vtn
Group=vtn
UMask=0077
WorkingDirectory=/opt/video-to-notes
EnvironmentFile=/etc/video-to-notes.env
Environment=PATH=/opt/video-to-notes/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/opt/video-to-notes/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8767 --workers 1
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/video-to-notes /opt/video-to-notes/data
MemoryMax=1400M

[Install]
WantedBy=multi-user.target
