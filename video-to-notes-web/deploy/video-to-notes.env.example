VTN_ACCESS_CONTROL=1
VTN_COOKIE_SECURE=1
VTN_PAID_CALLS_ENABLED=1
VTN_DATABASE_PATH=/var/lib/video-to-notes/vtn.sqlite3
VTN_DOUYIN_COOKIES_PATH=/var/lib/video-to-notes/douyin-cookies.txt
VTN_TRANSCRIBER=cloudflare
VTN_SESSION_SECRET=replace-with-a-long-random-value
CLOUDFLARE_ACCOUNT_ID=replace-on-server
CLOUDFLARE_API_TOKEN=replace-on-server
